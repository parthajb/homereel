<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The parent of the HomeReel.* text styles below. -->
    <style name="HomeReel" />

    <style name="HomeReel.Brand">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="HomeReel.HeroTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">22sp</item>
        <item name="android:autoSizeMaxTextSize">40sp</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <style name="HomeReel.Meta">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="HomeReel.Genres">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HomeReel.Body">
        <item name="android:textColor">@color/body</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="HomeReel.RowTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeReel.NavTab">
        <item name="android:background">@drawable/nav_tab</item>
        <item name="android:textColor">@color/nav_tab_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="HomeReel.Pill">
        <item name="android:background">@drawable/pill</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:drawableTint">@color/pill_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
