<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <include layout="@layout/hero_backdrop" />

    <!-- The page scrolls when More like this gets focus, so a long description never collides with it. -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="34dp"
        android:clipChildren="false"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/HomeReel.HeroTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/body"
            android:textSize="15sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <TextView
            android:id="@+id/meta"
            style="@style/HomeReel.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/genres"
            style="@style/HomeReel.Genres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/description"
            style="@style/HomeReel.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="4" />

        <TextView
            android:id="@+id/credits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Outside the 620dp text column: Resume, Play from start, Mark as unwatched and My List don't fit inside it,
         and the last button was squeezed to a sliver. -->
    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="56dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/play"
                style="@style/HomeReel.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_play_small"
                android:nextFocusDown="@id/more" />

            <Button
                android:id="@+id/restart"
                style="@style/HomeReel.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_restart_small"
                android:text="@string/play_from_start" />

            <Button
                android:id="@+id/watched"
                style="@style/HomeReel.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_check_small" />

            <Button
                android:id="@+id/my_list"
                style="@style/HomeReel.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_heart_outline_small"
                android:text="@string/my_list_add" />
    </LinearLayout>

    <TextView
        android:id="@+id/tech"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="16dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="24dp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
