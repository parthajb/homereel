<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <include layout="@layout/hero_backdrop" />

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="30dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/brand"
            style="@style/HomeReel.Brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/hero_title"
            style="@style/HomeReel.HeroTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/hero_meta"
            style="@style/HomeReel.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/hero_genres"
            style="@style/HomeReel.Genres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/hero_description"
            style="@style/HomeReel.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="3" />
    </LinearLayout>

    <!-- Up from the first row lands here: Search, and the profile watching. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="48dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/top_search"
            style="@style/HomeReel.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_search"
            android:text="@string/search"
            android:textSize="15sp" />

        <Button
            android:id="@+id/top_profile"
            style="@style/HomeReel.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:drawableStart="@drawable/ic_person"
            android:textSize="15sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="248dp"
        android:clipChildren="false" />
</FrameLayout>
